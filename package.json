{
  "name": "ecom-backend-optimized",
  "version": "2.0.0",
  "description": "Optimized e-commerce backend with TypeScript, Redis, BullMQ",
  "main": "dist/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "npm run build",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "sync:indexes": "node dist/scripts/sync-indexes.js",
    "migrate:product-catalog-sidecars": "node dist/scripts/migrate-product-catalog-sidecars.js",
    "migrate:revert-product-attributes": "node dist/scripts/revert-product-attributes.js",
    "migrate:spec-attributes": "node dist/scripts/migrate-spec-attributes.js",
    "migrate:product-category-link": "node dist/scripts/migrate-product-category-link.js",
    "setup:category-sections": "ts-node --transpile-only src/scripts/setup-category-sections.ts",
    "export:positive-stock-pdf": "node dist/scripts/exportPositiveStockPdf.js",
    "swagger:check": "node dist/scripts/checkSwaggerCoverage.js",
    "worker": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "worker:email": "ts-node-dev --respawn --transpile-only src/workers/email-worker.ts",
    "worker:order": "ts-node-dev --respawn --transpile-only src/workers/order-worker.ts",
    "worker:stock": "ts-node-dev --respawn --transpile-only src/workers/stock-worker.ts",
    "worker:notification": "ts-node-dev --respawn --transpile-only src/workers/notification-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.405.0",
    "@types/compression": "^1.8.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "google-auth-library": "^10.5.0",
    "handlebars": "^4.7.8",
    "helmet": "^6.0.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.1",
    "lodash.debounce": "^4.0.8",
    "mongoose": "^7.8.9",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "razorpay": "^2.9.2",
    "sharp": "^0.35.1",
    "slugify": "^1.6.6",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash.debounce": "^4.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
